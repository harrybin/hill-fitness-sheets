# Google Sheets API Configuration
# These environment variables are required for Google Sheets integration

# Get your API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Create or select a project
# 3. Enable Google Sheets API
# 4. Go to "Credentials" and create an API key
VITE_GOOGLE_API_KEY=your_api_key_here

# Get your OAuth 2.0 Client ID from Google Cloud Console:
# 1. In the same project, go to "Credentials"
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add authorized JavaScript origins: http://localhost:5173
# 4. Add authorized redirect URIs: http://localhost:5173
# 5. Copy the Client ID
VITE_GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
